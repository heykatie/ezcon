{
  "name": "ezcon",
  "version": "1.0.0",
  "description": "smooth out your convention experience",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:graph": "EZCON_GRAPH_TESTS=1 vitest run tests/graph-falkor.test.ts",
    "typecheck": "tsc --noEmit",
    "check:graph": "node --env-file=.env scripts/check-falkordb.mjs",
    "snapshot:data": "node --import tsx scripts/build-snapshot.ts",
    "research": "node --env-file=.env --import tsx scripts/research.ts",
    "check:roles": "node --import tsx scripts/check-roles.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heykatie/ezcon.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/heykatie/ezcon/issues"
  },
  "homepage": "https://github.com/heykatie/ezcon#readme",
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.180.0",
    "falkordb": "6.9.2",
    "node-html-parser": "7.0.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  }
}
